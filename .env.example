# ============================================================
# 部署环境变量示例：复制为 .env 后按需修改（docker compose 会自动读取）
#   Linux/macOS: cp .env.example .env
#   Windows    : Copy-Item .env.example .env
# .env 含密钥，不要提交到仓库（已在 .gitignore 中忽略）
# ============================================================

# 网关对外端口（用户端 / 管理端 / API 统一入口）
GATEWAY_PORT=8080

# MySQL 映射到宿主机器的端口（容器内固定 3306）
MYSQL_HOST_PORT=3307

# MySQL root 密码：后端容器用同一密码连接数据库
MYSQL_ROOT_PASSWORD=123456

# JWT 签名密钥（占位值，仅用于本地起服务）。部署前必须替换：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_SET_A_32_BYTE_SECRET_BEFORE_DEPLOY

# 后端 JVM 参数（容器内存受限时按比例分配堆内存）
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70
